# SchulHub - Konfiguration fuer den echten Betrieb (npm start).
# Kopiere diese Datei nach .env und trage eure Werte ein. .env NIEMALS einchecken.
# Fuer den lokalen Testmodus (npm run dev) brauchst du diese Datei nicht.

# --- Microsoft Entra ID (App-Registrierung der Schule) ---
# "Anwendungs-ID (Client)" und "Verzeichnis-ID (Mandant)" von der Uebersichtsseite
CLIENT_ID=00000000-0000-0000-0000-000000000000
TENANT_ID=00000000-0000-0000-0000-000000000000
# Der WERT des geheimen Clientschluessels (nicht die ID)
CLIENT_SECRET=paste-secret-value-here

# --- Wer darf rein, und mit welcher Rolle? (kommagetrennt) ---
# Schueler-Domain(s) -> Rolle Schueler/in, Personal-Domain(s) -> Rolle Lehrkraft.
# Steht eine Domain in beiden Listen, starten alle als Schueler/in.
STUDENT_EMAIL_DOMAINS=schueler.meine-schule.de
STAFF_EMAIL_DOMAINS=meine-schule.de
# Diese Adressen werden bei der Anmeldung Admin (mindestens eine eintragen).
ADMIN_EMAILS=schulleitung@meine-schule.de

# --- Adressen ---
# Oeffentliche Adresse des Hubs, immer mit https://. Redirect-URI in Entra: <BASE_URL>/auth/callback
BASE_URL=https://hub.meine-schule.de
# Eigene Domain fuer die Apps: jede App bekommt dort ihre Subdomain (Wildcard-DNS und
# Wildcard-Zertifikat fuer *.meine-schule-apps.de). NICHT unter der Domain des Hubs, also nicht
# apps.meine-schule.de: Apps koennten sonst Cookies fuer den Hub setzen und Browser aussperren.
# Der Hub startet mit so einer Adresse nicht.
APPS_DOMAIN=meine-schule-apps.de
# Port, auf dem Node lauscht (hinter dem Reverse-Proxy)
PORT=3000
# Anzahl der Reverse-Proxys vor dem Hub (noetig fuer HTTPS-Cookies und richtige IP-Adressen)
TRUST_PROXY=1

# --- Geheimnis fuer Sitzungen und Tokens ---
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Optional ---
# HUB_NAME=SchulHub
# DATA_DIR=data
# AUDIT_RETENTION_DAYS=365
# EXTRA_FILE_EXTENSIONS=ktx2,basis
# Nur wenn Hub und Apps unter einer oeffentlichen Endung wie co.uk liegen (die Startmeldung sagt es):
# APPS_PUBLIC_SUFFIX=co.uk
